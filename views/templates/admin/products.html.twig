{# Produkty bez kompletu danych GPSR. Lista robocza, nie podsumowanie. #}
{% extends '@Modules/quince_gpsr/views/templates/admin/layout.html.twig' %}
{% import '@Modules/quince_gpsr/views/templates/admin/_macros/icons.html.twig' as icons %}

{% trans_default_domain 'Modules.Quincegpsr.Admin' %}

{% set gapLabels = {
    'no_operator': 'No company at all'|trans,
    'no_eu_operator': 'Manufacturer outside the EU and no responsible operator named'|trans,
    'no_name': 'Company without a name'|trans,
    'no_address': 'Company without a full postal address'|trans,
    'no_contact': 'Company without an email or a contact form address'|trans
} %}

{% set filtered = filters.category or filters.brand or filters.phrase %}

{% block quince_intro %}
    <div class="qc-alert {{ incomplete ? 'qc-alert-warning' : 'qc-alert-info' }}">
        {{ icons.icon(incomplete ? 'alertCircle' : 'checkCircle', 18, 'qc-alert-icon') }}
        <div>
            {# Przy włączonym zawężeniu liczba dotyczy wybranych produktów, a nie
               całego sklepu. Zdanie mówiące „wszystkie produkty w sprzedaży"
               przy filtrze na jedną markę byłoby po prostu nieprawdziwe. #}
            {% if filtered %}
                {% if incomplete %}
                    {{ '%incomplete% of %checked% selected products cannot show everything the General Product Safety Regulation asks for.'|trans({'%incomplete%': incomplete, '%checked%': checked}) }}
                {% else %}
                    {{ 'All %checked% selected products show a responsible operator with a full address and an electronic address.'|trans({'%checked%': checked}) }}
                {% endif %}
            {% elseif incomplete %}
                {{ '%incomplete% of %checked% products on sale in %shop% cannot show everything the General Product Safety Regulation asks for.'|trans({'%incomplete%': incomplete, '%checked%': checked, '%shop%': shopName}) }}
            {% else %}
                {{ 'All %checked% products on sale in %shop% show a responsible operator with a full address and an electronic address.'|trans({'%checked%': checked, '%shop%': shopName}) }}
            {% endif %}
            {{ 'Products switched off are left out: they are not on offer, so article 19 does not apply to them.'|trans }}
        </div>
    </div>
{% endblock %}

{% block quince_body %}
<div class="qc-card">
    <div class="qc-card-head">
        <div>
            <div class="qc-card-title">{{ 'Products without GPSR data'|trans }}</div>
            <div class="qc-card-desc">
                {{ 'A missing safety text is not counted here: warnings belong to products that have them.'|trans }}
            </div>
        </div>
        {# Zawężenia: kategoria, marka, fraza. Marka jest tu najważniejsza, bo
           jedno przypisanie przy marce naprawia wszystkie jej produkty naraz. #}
        <form method="get" action="{{ path('quince_gpsr_products') }}" class="qc-hstack" style="gap:8px;flex-wrap:wrap">
            <div class="qc-select-wrap">
                <select class="qc-field-base qc-select qc-focusable" name="category" style="width:200px">
                    <option value="0">{{ 'Any category'|trans }}</option>
                    {% for kategoria in categories %}
                        <option value="{{ kategoria.id }}" {{ filters.category == kategoria.id ? 'selected' : '' }}>{{ kategoria.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="qc-select-wrap">
                <select class="qc-field-base qc-select qc-focusable" name="brand" style="width:180px">
                    <option value="0">{{ 'Any brand'|trans }}</option>
                    {% for marka in brands %}
                        <option value="{{ marka.id }}" {{ filters.brand == marka.id ? 'selected' : '' }}>{{ marka.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <input class="qc-field-base qc-focusable" type="search" name="q" value="{{ filters.phrase }}"
                   style="width:180px" placeholder="{{ 'Name or reference'|trans }}">

            <button type="submit" class="qc-btn qc-btn-outline">{{ icons.icon('search', 14) }}</button>

            {% if filtered %}
                <a href="{{ path('quince_gpsr_products') }}" class="qc-btn qc-btn-text">{{ 'Clear'|trans }}</a>
            {% endif %}
        </form>
    </div>

    <div class="qc-card-body">
        {% if products is empty %}
            <div class="qc-hint">{{ 'Nothing to fix here.'|trans }}</div>
        {% else %}
            <table class="qc-table">
                <thead>
                    <tr>
                        <th>{{ 'Product'|trans }}</th>
                        <th>{{ 'Manufacturer'|trans }}</th>
                        <th>{{ 'Responsible operator'|trans }}</th>
                        <th>{{ 'What is missing'|trans }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for produkt in products %}
                        <tr>
                            <td>
                                {{ produkt.name }}
                                <div class="qc-hint">
                                    {{ produkt.reference ?: '#' ~ produkt.id_product }}
                                    {%- if produkt.from_brand %} · {{ 'set on the brand'|trans }}{% endif %}
                                    {%- if produkt.from_product %} · {{ 'set on the product'|trans }}{% endif %}
                                </div>
                            </td>
                            <td>
                                {% if produkt.manufacturer %}
                                    {{ produkt.manufacturer.trade_name ?: produkt.manufacturer.code }}
                                    {% if produkt.manufacturer.country %}
                                        <span class="qc-badge">{{ produkt.manufacturer.country }}</span>
                                    {% endif %}
                                {% else %}
                                    <span class="qc-badge qc-badge-warning">{{ 'Missing'|trans }}</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if produkt.responsible %}
                                    {{ produkt.responsible.trade_name ?: produkt.responsible.code }}
                                {% else %}
                                    <span class="qc-badge qc-badge-warning">{{ 'Missing'|trans }}</span>
                                {% endif %}
                            </td>
                            <td>
                                {% for brak in produkt.gaps %}
                                    <div>{{ gapLabels[brak]|default(brak) }}</div>
                                {% endfor %}
                            </td>
                            <td>
                                <a class="qc-btn qc-btn-text" target="_blank"
                                   href="{{ path('admin_products_edit', {'productId': produkt.id_product}) }}">
                                    {{ icons.icon('edit', 14) }} {{ 'Open product'|trans }}
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            {% if pages > 1 %}
                <div class="qc-table-foot">
                    <span>{{ 'Page %page% of %pages%'|trans({'%page%': page, '%pages%': pages}) }}</span>

                    <span class="qc-hstack" style="gap:8px">
                        {% if page > 1 %}
                            <a class="qc-btn qc-btn-text" href="{{ path('quince_gpsr_products', {'page': page - 1, 'category': filters.category, 'brand': filters.brand, 'q': filters.phrase}) }}">{{ 'Back'|trans }}</a>
                        {% endif %}
                        {% if page < pages %}
                            <a class="qc-btn qc-btn-text" href="{{ path('quince_gpsr_products', {'page': page + 1, 'category': filters.category, 'brand': filters.brand, 'q': filters.phrase}) }}">{{ 'Next'|trans }}</a>
                        {% endif %}
                    </span>
                </div>
            {% endif %}
        {% endif %}
    </div>
</div>
{% endblock %}

    <svg class="qc-icon{{ extraClass ? ' ' ~ extraClass }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 16 16" fill="none"
         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
         aria-hidden="true">
        <path d="{{ paths[name]|default(paths['box']) }}"/>
    </svg>
{% endmacro %}

{#
  Ikona komunikatu dobrana do jego rodzaju.

  `danger`:  coś się nie udało albo dane są nieważne  → wykrzyknik w kole
  `warn`:    ustawienie jest niepełne, grozi skutkiem → wykrzyknik w trójkącie
  `info`:    wyjaśnienie zasady, nic się nie psuje    → litera „i"
  `success`: warunek spełniony                        → znak zatwierdzenia
#}
{% macro message(level, size = 14, extraClass = '') %}
    {# Makra w Twigu 3 nie widzą zakresu pliku, więc import musi stać w ciele makra. #}
    {%- import _self as ico -%}
    {%- set map = {
        'danger':  'alertCircle',
        'warn':    'alertTriangle',
        'warning': 'alertTriangle',
        'info':    'info',
        'success': 'checkCircle'
    } -%}
    {{- ico.icon(map[level]|default('info'), size, extraClass) -}}
{% endmacro %}
